# Copia este archivo a .env (o define las variables en tu proveedor de hosting).
PORT=3000
# Orígenes permitidos por CORS, separados por coma.
ALLOWED_ORIGINS=https://tonatiuhliera.com,https://www.tonatiuhliera.com,http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
# Ruta del archivo de base de datos (por defecto data/db.json).
# DB_FILE=/var/data/db.json
